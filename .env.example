# Email/password accounts are stored on the server. No OAuth configuration is needed.

# Optional: a long random string used to sign session cookies.
# If omitted, the server creates data/.session-secret and reuses it across restarts.
# SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: store accounts and tasks somewhere else (defaults to ./data).
# DATA_DIR=

# Legacy migration: the first account created adopts the personal tasks and
# team ownership of the previous no-sign-in local profile. Leave these unset
# for a fresh install, or set them to the old profile's values to keep its data.
# LEGACY_LOCAL_SUB=local-user
# LEGACY_LOCAL_EMAIL=local@localhost

# Optional: change the API port (defaults to 3001).
# PORT=3001
