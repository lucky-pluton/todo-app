# Google OAuth credentials
# Create them at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the app, without a trailing slash.
# Leave empty to infer it from each request (works for localhost and most hosts).
# APP_URL=https://tasks.example.com

# Required in production so browser sessions survive restarts and redeploys.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Optional: only this Google account can claim an existing data/tasks.json file.
# Without it, the first Google account that signs in claims the old data.
# LEGACY_OWNER_EMAIL=you@gmail.com

# Optional: use a different OAuth redirect URL than <APP_URL>/api/auth/google/callback.
# OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
